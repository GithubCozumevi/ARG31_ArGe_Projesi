# Bu dosyayi .env olarak kopyala ve gercek degerleri gir

# MinIO baglantisi (dogrudan dosya yukleme/indirme icin)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=degistir
MINIO_SECRET_KEY=degistir
MINIO_SECURE=false

# MLflow tracking server adresi
MLFLOW_TRACKING_URI=http://localhost:5000

# MLflow'un artifact'lari MinIO'ya S3 uyumlu sekilde yazabilmesi icin
# (ayni access key/secret key, MLflow icin farkli isimlerle tekrar tanimlanir)
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=degistir
AWS_SECRET_ACCESS_KEY=degistir

# Satici sozlugu dosyasi (opsiyonel; varsayilan: data/satici_sozlugu.json)
# SATICI_SOZLUGU_YOLU=

# Fis gorsellerinin yuklendigi MinIO bucket'i (opsiyonel; varsayilan: masraf-fisler)
# MINIO_BUCKET=masraf-fisler

# /extract/vkn sonuclarini MLflow'a yaz (opsiyonel; varsayilan: true, kapatmak icin false)
# MLFLOW_LOG_AKTIF=true
